# API Endpoint (ローカル開発時はViteプロキシ経由でWranglerに転送)
VITE_API_ENDPOINT=/api/parse-command

# Metered.ca TURN Server (国際間P2P接続に必要)
# https://www.metered.ca/stun-turn でサインアップしてAPIキーを取得
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# 任意: カンマ区切りでTURN URLを上書き
# 例: turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
VITE_TURN_URLS=

# 任意: Nostrリレー一覧をカンマ区切りで上書き（同じ値を全クライアントで共有すること）
# 例: wss://nos.lol,wss://relay.fountain.fm,wss://nostr.data.haus
VITE_NOSTR_RELAY_URLS=